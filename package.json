{
  "name": "cutdown-parser",
  "version": "0.7.2",
  "description": "Cutdown markup language parser in TypeScript",
  "keywords": [
    "AST",
    "cutdown",
    "markdown",
    "parser"
  ],
  "homepage": "https://github.com/cuttie-app/cutdown-ts",
  "bugs": {
    "url": "https://github.com/cuttie-app/cutdown-ts/issues"
  },
  "license": "MIT",
  "author": "Cuttie App (https://github.com/cuttie-app)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuttie-app/cutdown-ts.git"
  },
  "funding": {
    "url": "https://github.com/sponsors/cuttie-app"
  },
  "bin": {
    "cutdown-parser": "dist/cutdown-parser.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config .config/tsdown.config.ts",
    "prepublishOnly": "pnpm run build",
    "test": "vitest --config .config/vitest.config.ts run",
    "check:ts": "tsc --noEmit",
    "check:format": "oxfmt . -c .config/.oxfmtrc.json --check",
    "check:lint": "oxlint . -c .config/.oxlintrc.json",
    "format": "oxfmt . -c .config/.oxfmtrc.json --write"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.1.0",
    "js-yaml": "5.2.1",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0-beta.4"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.9.0"
}
